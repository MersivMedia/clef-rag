# clef-rag environment. Copy to .env and fill in only what you use:
#   cp .env.example .env && chmod 600 .env
# The clef-rag CLI reads ./.env automatically (--env-file to choose another file,
# --no-env-file to skip). Variables already set in your shell take precedence.
# Empty values are ignored. Never commit .env.

# --- Clef: Workers AI (hosted) ---
# A Cloudflare API token with Workers AI permission, and your account id
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Clef: self-hosted (`clef-rag serve` on your GPU, or any System One server) ---
CLEF_BASE_URL=
# only if the server was started with --api-key-env
CLEF_API_KEY=

# --- Embeddings ---
# openai:<model>, and the openai answer provider
OPENAI_API_KEY=
# gateway:<model> embeddings / gateway answer provider (Vercel AI Gateway)
AI_GATEWAY_API_KEY=
# ollama:<model> (default http://localhost:11434)
OLLAMA_HOST=

# --- Answer LLM (only for `clef-rag query --answer` / Pipeline.answer) ---
# anthropic answer provider
ANTHROPIC_API_KEY=
# OpenRouter, only for the `clef-rag eval --llm-rerank` baseline (provider: openrouter)
OPENROUTER_API_KEY=

# --- Vector databases (only the one you use) ---
# pgvector: read via store.dsn_env (default DATABASE_URL),
# e.g. postgresql://user:password@localhost:5432/dbname
DATABASE_URL=
# Qdrant Cloud (not needed for a local server or embedded mode)
QDRANT_API_KEY=
# Pinecone (experimental adapter): key, plus cloud/region for index creation (defaults aws / us-east-1)
PINECONE_API_KEY=
PINECONE_CLOUD=
PINECONE_REGION=

# --- Debugging ---
# 1 = full tracebacks from the CLI
CLEF_RAG_DEBUG=
